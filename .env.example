# Server Configuration
PORT=5000

# Groq AI API Key
# Get your API key from: https://console.groq.com/
GROQ_API_KEY=your_groq_api_key_here

# Nutrition API Configuration
# Choose one of the following APIs:
# 1. Edamam: https://developer.edamam.com/
# 2. Nutritionix: https://www.nutritionix.com/business/api
# 3. Spoonacular: https://spoonacular.com/food-api

# For Edamam (Nutrition Analysis API)
NUTRITION_API_KEY=your_nutrition_api_key_here
NUTRITION_APP_ID=your_nutrition_app_id_here

# For Nutritionix (uncomment if using)
# NUTRITIONIX_APP_ID=your_nutritionix_app_id
# NUTRITIONIX_APP_KEY=your_nutritionix_app_key

# For Spoonacular (uncomment if using)
# SPOONACULAR_API_KEY=your_spoonacular_api_key
